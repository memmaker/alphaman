' ALPCLIB.C functions (port/alpclib.h), same names as the CDECL declares.
DECLARE LIBRARY "./alpclib"
  SUB rv_setpage (BYVAL p%, BYVAL ptr AS _OFFSET)
  SUB rv_setpag2 (BYVAL ptr AS _OFFSET)
  FUNCTION rv_pag2get% (BYVAL x%, BYVAL y%)
  SUB rv_dump (path$)
  FUNCTION rv_visible% ()
  SUB rv_winsize (BYVAL w%, BYVAL h%)
  SUB ccls (BYVAL pag%)
  SUB ClearRight ALIAS "clearright" (BYVAL pag%)
  SUB Box ALIAS "box" (BYVAL lc%, BYVAL rc%, BYVAL tc%, BYVAL bc%, BYVAL nl%, BYVAL fclr%, BYVAL pag%)
  SUB cPutSym ALIAS "cputsym" (BYVAL sym%, BYVAL x%, BYVAL y%, BYVAL fc%, BYVAL bc%, BYVAL pag%)
  FUNCTION cGetSym% ALIAS "cgetsym" (BYVAL x%, BYVAL y%, BYVAL pag%)
  SUB cRandomize ALIAS "crandomize" (BYVAL seed!)
  FUNCTION Confuse% ALIAS "confuse" (BYVAL r%, BYVAL i%)
  FUNCTION RollDice% ALIAS "rolldice" (BYVAL dsize%, BYVAL nroll%, BYVAL nuse%)
  FUNCTION cRd% ALIAS "crd" (BYVAL x%, BYVAL y%)
  FUNCTION cRdSimp% ALIAS "crdsimp" (BYVAL x%, BYVAL y%)
  FUNCTION cRoll% ALIAS "croll" (BYVAL max%)
  FUNCTION cFindDxDy% ALIAS "cfinddxdy" (BYVAL x%, BYVAL y%, BYVAL n%)
  FUNCTION RoomIt% ALIAS "roomit" (BYVAL xr%, BYVAL xl%, BYVAL yb%, BYVAL yt%)
  SUB Lair ALIAS "lair" (xr%, xl%, yb%, yt%, xs%, ys%)
  SUB FindDot ALIAS "finddot" (x%, y%, BYVAL i%)
  SUB cMainMap ALIAS "cmainmap" (BYVAL irnd%, BYVAL jrnd%)
  SUB cDetailedMap ALIAS "cdetailedmap" (BYVAL t%, BYVAL t1%, BYVAL t2%, BYVAL t3%, BYVAL t4%)
  SUB CreatSort ALIAS "creatsort" (BYVAL nnear%, tentgrab%, nn%)
  FUNCTION cSameRoom% ALIAS "csameroom" (BYVAL x1%, BYVAL y1%, BYVAL x2%, BYVAL y2%, BYVAL lx%, BYVAL ly%, BYVAL n%, nn%)
  FUNCTION BadMoveCreat% ALIAS "badmovecreat" (BYVAL dx%, BYVAL dy%, BYVAL n%, BYVAL c%, nn%)
END DECLARE
